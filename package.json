{
  "name": "agent-workflow-kit",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Claude Workflows-style orchestration for Codex, Gemini, OpenCode, Grok, Pi, and Antigravity.",
  "license": "MIT",
  "homepage": "https://github.com/moabualruz/agent-workflow-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moabualruz/agent-workflow-kit.git"
  },
  "bugs": {
    "url": "https://github.com/moabualruz/agent-workflow-kit/issues"
  },
  "keywords": [
    "agent-workflows",
    "agentic-workflows",
    "ai-agents",
    "cli",
    "orchestration",
    "workflow-engine",
    "claude-workflows",
    "claude-code",
    "codex",
    "gemini-cli",
    "opencode",
    "grok",
    "pi",
    "antigravity",
    "developer-tools",
    "typescript",
    "plugins",
    "multi-agent",
    "coding-agents",
    "automation"
  ],
  "packageManager": "bun@1.2.15",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "install-smoke": "bun scripts/install-smoke.ts --require-tools",
    "headless-smoke": "bun scripts/headless-smoke.ts --require-tools",
    "headless-smoke:live": "bun scripts/headless-smoke.ts --require-tools --run"
  },
  "bin": {
    "agent-workflow-kit": "packages/cli/src/cli.ts"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.15.12"
  }
}
